# Copia in `.env.local` per lo sviluppo; su Vercel imposta le stesse chiavi
# in Project Settings → Environment Variables.
# Niente login: l'account è legato al dispositivo (cookie automatico),
# nessun segreto da configurare.

# Connection string pooled di Neon (Neon Console → Connect → pooled).
# Es: postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/eurocollection?sslmode=require

# ------------------------------------------------------------
# Riconoscimento monete dalle foto (fronte + retro)
# ------------------------------------------------------------
# Chiave di un provider OpenAI-compatibile con un modello vision.
# Su Freebuff: Account → Developer API (https://freebuff.com/account/api).
# Senza chiave il flusso resta usabile: la UI propone la ricerca manuale.
OPENAI_API_KEY=
# Endpoint API (default: Freebuff). Per OpenAI usare
# https://api.openai.com/v1
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
# Modello vision (default: gpt-4o-mini). Su Freebuff vanno bene anche
# qwen3-vl-30b-a3b-instruct o gemini-2.5-flash.
OPENAI_VISION_MODEL=gpt-4o-mini
